    {
      "id": "H51",
      "name": "submission-ledger",
      "script": "logging/submission_ledger.py",
      "events": ["post_tool"],
      "tools": ["bash"],
      "path_patterns": [],
      "mode": "warn",
      "timeout": 5
    },
    {
      "id": "H52",
      "name": "checklist-sync",
      "script": "logging/checklist_sync.py",
      "events": ["stop"],
      "tools": [],
      "path_patterns": [],
      "mode": "warn",
      "timeout": 5
    }
  ]
}
