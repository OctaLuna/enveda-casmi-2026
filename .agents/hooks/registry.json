      "events": ["post_tool"],
      "tools": ["write", "edit", "multiedit"],
      "path_patterns": ["*.py"],
      "mode": "warn",
      "timeout": 10
    },
    {
      "id": "H41",
      "name": "notebook-hygiene",
      "script": "quality/notebook_hygiene.py",
      "events": ["git_pre_commit"],
      "tools": [],
