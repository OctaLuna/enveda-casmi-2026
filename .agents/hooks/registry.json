      "events": ["post_tool"],
      "tools": ["write", "edit", "multiedit"],
      "path_patterns": ["src/prep*/**", "src/data/**"],
      "mode": "warn",
      "timeout": 10
    },
    {
      "id": "H27",
      "name": "time-budget-guard",
      "script": "domain/time_budget_guard.py",
      "events": ["post_tool", "git_pre_push", "pre_submit"],
      "tools": ["write", "edit", "multiedit"],
      "path_patterns": ["configs/budget.yaml", "*budget*.yaml"],
      "mode": "block",
      "timeout": 5
    },
    {
      "id": "H28",
      "name": "packaging-manifest-check",
      "script": "domain/packaging_manifest_check.py",
      "events": ["git_pre_push", "pre_submit"],
      "tools": [],
      "path_patterns": ["kaggle/manifest.yaml", "src/inference/*"],
      "mode": "block",
      "timeout": 5
    },
    {
      "id": "H29",
      "name": "license-ledger",
