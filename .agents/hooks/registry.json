      "timeout": 30
    },
    {
      "id": "H43",
      "name": "dependency-lock-check",
      "script": "quality/dependency_lock_check.py",
      "events": ["post_tool"],
      "tools": ["write", "edit", "multiedit"],
      "path_patterns": ["requirements*.txt", "pyproject.toml", "environment.yml"],
