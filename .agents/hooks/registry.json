      "tools": ["write", "edit", "multiedit", "bash"],
      "path_patterns": ["data/external/*", "models/external/*"],
      "mode": "block",
      "timeout": 5
    },
    {
      "id": "H30",
      "name": "seed-determinism",
      "script": "domain/seed_determinism.py",
      "events": ["post_tool"],
      "tools": ["write", "edit", "multiedit"],
      "path_patterns": ["src/models/**", "src/data/split*"],
      "mode": "warn",
      "timeout": 5
    },
    {
      "id": "H40",
      "name": "format-lint",
