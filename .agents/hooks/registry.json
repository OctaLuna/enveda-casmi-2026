      "mode": "block",
      "timeout": 5
    },
    {
      "id": "H42",
      "name": "fast-tests",
      "script": "quality/fast_tests.py",
      "events": ["git_pre_push", "pre_submit"],
      "tools": [],
      "path_patterns": [],
