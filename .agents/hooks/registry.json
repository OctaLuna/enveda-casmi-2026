    {
      "id": "H50",
      "name": "experiment-logger",
      "script": "logging/experiment_logger.py",
      "events": ["stop", "subagent_stop"],
      "tools": [],
      "path_patterns": [],
      "mode": "warn",
      "timeout": 10
