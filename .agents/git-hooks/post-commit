#!/usr/bin/env python
"""
G06 - post-commit
Registra cada commit realizado en .agents/state/activity.log
(timestamp, hash abreviado, asunto del commit).
"""

from datetime import datetime
from pathlib import Path
import subprocess
import sys


def main():
    try:
        proc = subprocess.run(["git", "log", "-1", "--format=%h|%s"], capture_output=True, text=True, check=False)
        if proc.returncode == 0 and proc.stdout.strip():
            commit_hash, subject = proc.stdout.strip().split("|", 1)
            now_str = datetime.now().strftime("%Y-%m-%d %H:%M:%S")

            root = Path(__file__).resolve().parent.parent.parent
            log_dir = root / ".agents" / "state"
            log_dir.mkdir(parents=True, exist_ok=True)
            log_file = log_dir / "activity.log"

            with open(log_file, "a", encoding="utf-8") as f:
                f.write(f"[{now_str}] commit {commit_hash} - {subject}\n")
    except Exception:
        pass

    sys.exit(0)


if __name__ == "__main__":
    main()
